# DJANGO SETTINGS
DEBUG=True
SECRET_KEY=generate-a-long-secret-key-here

# DATABASE - SQLite is used by default
# If using Postgres, add your DATABASE_URL here

# MONGODB (Required for Activity Logs)
MONGO_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/smart_property?retryWrites=true&w=majority

# EMAIL CONFIGURATION (IMPORTANT)
# Use 'console' for local testing (prints to terminal)
# Use 'smtp' for real email delivery (Gmail/Outlook/SES)
EMAIL_BACKEND_TYPE=console

# SMTP DETAILS (Example for Gmail)
EMAIL_DISPLAY_NAME=Smart Property
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# GMAIL AUTHENTICATION
# 1. Enable 2-Factor Authentication (2FA) in your Google Account
# 2. Search for 'App Passwords' in Google Security settings
# 3. Create a new App Password (select 'Other' and name it 'SmartProperty')
# 4. Use that 16-character code as your EMAIL_HOST_PASSWORD below.
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Smart Property <your-email@gmail.com>
